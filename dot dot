@app.route("/api/query", methods=["POST"])
def query_api():

    # --------------------------------------------------------
    # CHECK DATASET
    # --------------------------------------------------------

    if df.empty:

        return jsonify({
            "success": False,
            "error": "Dataset is not loaded."
        }), 500

    # --------------------------------------------------------
    # GET REQUEST DATA
    # --------------------------------------------------------

    data = request.get_json(
        silent=True
    )

    if not data:

        return jsonify({
            "success": False,
            "error": "Request body must contain JSON."
        }), 400

    # --------------------------------------------------------
    # GET QUESTION
    # --------------------------------------------------------

    question = data.get(
        "question",
        ""
    )

    if not isinstance(question, str):

        return jsonify({
            "success": False,
            "error": "Question must be a string."
        }), 400

    question = question.strip()

    if not question:

        return jsonify({
            "success": False,
            "error": "Question cannot be empty."
        }), 400

    # --------------------------------------------------------
    # DEALER CODE QUERY
    # --------------------------------------------------------

    if is_dealer_code_question(
        question
    ):

        print("\n" + "=" * 60)
        print("DEALER CODE QUERY")
        print("=" * 60)

        print(
            f"Question: {question}"
        )

        dealer_code_result = (
            handle_dealer_code_query(
                question
            )
        )

        print(
            "Dealer Code Result:",
            dealer_code_result
        )

        print("=" * 60 + "\n")

        return jsonify(
            dealer_code_result
        )

    # --------------------------------------------------------
    # RUN QUERY ENGINE
    # --------------------------------------------------------

    try:

        query_result = query(
            question,
            df
        )

        # ----------------------------------------------------
        # GENERATE RESPONSE
        # ----------------------------------------------------

        response = generate_response(
            query_result
        )

        # ----------------------------------------------------
        # RETURN RESULT
        # ----------------------------------------------------

        return jsonify({
            "success": True,
            "question": question,
            "intent": query_result.get(
                "intent"
            ),
            "result": query_result.get(
                "result",
                {}
            ),
            "response": response,
        })

    except Exception as error:

        print("\n" + "=" * 60)
        print("QUERY API ERROR")
        print("=" * 60)

        traceback.print_exc()

        print("=" * 60 + "\n")

        return jsonify({
            "success": False,
            "error": str(error),
        }), 500


# ============================================================
# COPILOT WORKFLOW HTTP ENDPOINT
# ============================================================

def _get_copilot_workflow_endpoint():
    endpoint = os.getenv("MARCH_COPILOT_WORKFLOW_URL", "").strip()
    if not endpoint:
        raise RuntimeError(
            "Copilot Workflow endpoint is not configured. "
            "Add MARCH_COPILOT_WORKFLOW_URL to your .env file."
        )
    return endpoint


def _build_verified_context(question, query_result, dataset_name="Sales_Inventory"):
    result_json = json.dumps(
        query_result.get("result", {}),
        ensure_ascii=False,
        indent=2,
        default=str,
    )
    intent = query_result.get("intent", "unknown")
    return f"""
USER QUESTION:
{question}

VERIFIED PYTHON ANALYSIS OUTPUT:
Dataset: {dataset_name}
Analysis intent: {intent}
Calculated by: Local Python analytics engine

RESULT:
{result_json}

RESPONSE REQUIREMENTS:
- Use the verified Python output above as the only source of truth for all figures, rankings, percentages, dates, names and metrics.
- Do not calculate, estimate, guess, invent, change or contradict data.
- Do not mix SPD_DATA with Sales/Inventory data.
- Answer in concise, professional British English.
- Start with the direct answer or key business finding.
- Preserve the metric supplied by Python, such as units, records, customers, activations, or sales.
- You may provide practical recommendations, but clearly separate them from verified findings and use cautious language such as:
  "This may indicate..." or "It may be useful to review...".
- If the verified result is empty, unsupported, or unknown, state that the available Python analysis does not support an accurate answer.
""".strip()


def _call_copilot_workflow(question, query_result):
    endpoint = _get_copilot_workflow_endpoint()
    payload = {
        "question": question,
        "verified_context": _build_verified_context(
            question,
            query_result,
            "Sales_Inventory",
        ),
    }
    body = json.dumps(payload, ensure_ascii=False).encode("utf-8")
    req = urllib.request.Request(
        endpoint,
        data=body,
        headers={
            "Content-Type": "application/json",
            "Accept": "application/json, text/plain, */*",
        },
        method="POST",
    )
    try:
        with urllib.request.urlopen(req, timeout=120) as response:
            response_body = response.read().decode("utf-8")
            if not response_body.strip():
                raise RuntimeError("Copilot Workflow returned an empty response.")
            return response_body.strip()
    except urllib.error.HTTPError as error:
        try:
            error_body = error.read().decode("utf-8", errors="replace")
        except Exception:
            error_body = ""
        print(f"Copilot Workflow HTTP error: {error.code}")
        if error_body:
            print("Copilot Workflow response:")
            print(error_body)
        raise RuntimeError(
            f"Copilot Workflow returned HTTP {error.code}: "
            f"{error_body or error.reason}"
        ) from error
    except urllib.error.URLError as error:
        raise RuntimeError(
            f"Could not connect to the Copilot Workflow endpoint: {error.reason}"
        ) from error
    except Exception as error:
        raise RuntimeError(f"Copilot Workflow request failed: {error}") from error


# ============================================================
# DEXTER AI CHAT API
# ============================================================

@app.route("/api/ai/chat", methods=["POST"])
def dexter_chat():

    # --------------------------------------------------------
    # CHECK DATASET
    # --------------------------------------------------------

    if df.empty:

        return jsonify({
            "success": False,
            "error": "Dataset is not loaded."
        }), 500

    # --------------------------------------------------------
    # GET REQUEST DATA
    # --------------------------------------------------------

    data = request.get_json(
        silent=True
    )

    if not data:

        return jsonify({
            "success": False,
            "error": "Request body must contain JSON."
        }), 400

    # --------------------------------------------------------
    # GET QUESTION
    # --------------------------------------------------------

    question = data.get(
        "question",
        ""
    )

    if not isinstance(question, str):

        return jsonify({
            "success": False,
            "error": "Question must be a string."
        }), 400

    question = question.strip()

    if not question:

        return jsonify({
            "success": False,
            "error": "Question cannot be empty."
        }), 400

    # --------------------------------------------------------
    # GET CONVERSATION ID
    # --------------------------------------------------------

    conversation_id = data.get(
        "conversation_id"
    )

    if conversation_id is not None:

        if not isinstance(
            conversation_id,
            str
        ):

            return jsonify({
                "success": False,
                "error": (
                    "conversation_id must be a string "
                    "or null."
                )
            }), 400

        conversation_id = (
            conversation_id.strip()
        )

        if not conversation_id:
            conversation_id = None

    # --------------------------------------------------------
    # LOG REQUEST
    # --------------------------------------------------------

    print("\n" + "=" * 60)
    print("DEXTER AI CHAT")
    print("=" * 60)

    print(
        f"Question: {question}"
    )

    print(
        f"Conversation ID: {conversation_id}"
    )

    # --------------------------------------------------------
    # RUN VERIFIED PYTHON ANALYSIS
    # --------------------------------------------------------

    try:

        if is_dealer_code_question(
            question
        ):

            print(
                "Analysis type: Dealer Code"
            )

            dealer_code_result = (
                handle_dealer_code_query(
                    question
                )
            )

            query_result = {
                "success":
                    dealer_code_result.get(
                        "success",
                        False
                    ),
                "intent":
                    dealer_code_result.get(
                        "intent",
                        "dealer_code"
                    ),
                "result":
                    dealer_code_result.get(
                        "result",
                        {}
                    ),
            }

        else:

            print(
                "Analysis type: Query Engine"
            )

            query_result = query(
                question,
                df
            )

        print(
            "\nVERIFIED PYTHON RESULT:"
        )

        print(
            query_result
        )

    except Exception as error:

        print("\n" + "=" * 60)
        print("DEXTER PYTHON ANALYSIS ERROR")
        print("=" * 60)

        traceback.print_exc()

        print("=" * 60 + "\n")

        return jsonify({
            "success": False,
            "error": (
                "Python analytics could not process "
                f"the question: {str(error)}"
            ),
        }), 500

    # --------------------------------------------------------
    # SEND VERIFIED RESULT TO COPILOT WORKFLOW
    # --------------------------------------------------------

    try:

        print(
            "\nSending verified result to Copilot Workflow..."
        )

        answer = _call_copilot_workflow(
            question=question,
            query_result=query_result,
        )

        print(
            "Copilot Workflow response received."
        )

        print("=" * 60 + "\n")

        return jsonify({
            "success": True,
            "question": question,
            "answer": answer,
            "conversation_id": conversation_id,
            "intent": query_result.get("intent"),
        })

    except Exception as error:

        print("\n" + "=" * 60)
        print("DEXTER AI ERROR")
        print("=" * 60)

        traceback.print_exc()

        print("=" * 60 + "\n")

        return jsonify({
            "success": False,
            "error": (
                "Dexter could not process the request: "
                f"{str(error)}"
            ),
        }), 502



