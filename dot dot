# DEALER CODE QUERY
# ============================================================

def is_dealer_code_question(question):

    normalized_question = (
        question
        .lower()
        .strip()
    )

    dealer_code_patterns = [
        r"\bdealer\s*code\b",
        r"\bdealercode\b",
        r"\bdealer\s*id\b",
        r"\bcode\s+for\s+(?:the\s+)?dealer\b",
        r"\bcode\s+of\s+(?:the\s+)?dealer\b",
    ]

    return any(
        re.search(
            pattern,
            normalized_question
        )
        for pattern in dealer_code_patterns
    )


def handle_dealer_code_query(question):

    # --------------------------------------------------------
    # CHECK REQUIRED COLUMNS
    # --------------------------------------------------------

    if "Dealer_Code" not in df.columns:

        return {
            "success": False,
            "intent": "dealer_code",
            "result": {},
            "response": (
                "The uploaded dataset does not contain "
                "a Dealer_Code column."
            )
        }

    if "Dealer_Name" not in df.columns:

        return {
            "success": False,
            "intent": "dealer_code",
            "result": {},
            "response": (
                "The uploaded dataset does not contain "
                "a Dealer_Name column."
            )
        }

    # --------------------------------------------------------
    # NORMALIZE QUESTION
    # --------------------------------------------------------

    normalized_question = (
        question
        .lower()
        .strip()
    )

    # --------------------------------------------------------
    # TRY TO FIND DEALER NAME
    # --------------------------------------------------------

    dealer_name = None

    patterns = [
        r"\bdealer\s*code\s+(?:for|of)\s+(.+)$",
        r"\bdealer\s*id\s+(?:for|of)\s+(.+)$",
        r"\bcode\s+(?:for|of)\s+(?:the\s+)?dealer\s+(.+)$",
        r"\bdealer\s+(.+?)['’]s\s+(?:dealer\s+)?code\b",
        r"\bcode\s+for\s+(.+)$",
    ]

    for pattern in patterns:

        match = re.search(
            pattern,
            normalized_question
        )

        if match:

            dealer_name = (
                match.group(1)
                .strip()
                .rstrip("?")
                .strip()
            )

            break

    # --------------------------------------------------------
    # NO DEALER NAME PROVIDED
    # --------------------------------------------------------

    if not dealer_name:

        unique_dealers = (
            df[
                [
                    "Dealer_Name",
                    "Dealer_Code"
                ]
            ]
            .dropna()
            .drop_duplicates()
        )

        return {
            "success": True,
            "intent": "dealer_code",
            "result": {
                "dealer_codes": unique_dealers[
                    "Dealer_Code"
                ]
                .astype(str)
                .unique()
                .tolist()
            },
            "response": (
                "There are multiple dealers in the dataset. "
                "Please provide the dealer name so I can "
                "give you the correct Dealer Code."
            )
        }

    # --------------------------------------------------------
    # SEARCH DEALER NAME
    # --------------------------------------------------------

    dealer_names = (
        df["Dealer_Name"]
        .fillna("")
        .astype(str)
        .str.strip()
    )

    search_name = dealer_name.lower()

    exact_match = (
        dealer_names.str.lower()
        == search_name
    )

    matched_rows = df.loc[
        exact_match,
        [
            "Dealer_Name",
            "Dealer_Code"
        ]
    ].dropna()

    # --------------------------------------------------------
    # PARTIAL MATCH
    # --------------------------------------------------------

    if matched_rows.empty:

        partial_match = (
            dealer_names
            .str.lower()
            .str.contains(
                search_name,
                regex=False,
                na=False
            )
        )

        matched_rows = df.loc[
            partial_match,
            [
                "Dealer_Name",
                "Dealer_Code"
            ]
        ].dropna()

    # --------------------------------------------------------
    # DEALER NOT FOUND
    # --------------------------------------------------------

    if matched_rows.empty:

        return {
            "success": True,
            "intent": "dealer_code",
            "result": {
                "dealer_name": dealer_name,
                "dealer_code": None,
            },
            "response": (
                f"I could not find a dealer named "
                f"'{dealer_name}' in the dataset."
            )
        }

    # --------------------------------------------------------
    # UNIQUE DEALER / CODE PAIRS
    # --------------------------------------------------------

    matched_rows = (
        matched_rows
        .drop_duplicates()
        .reset_index(drop=True)
    )

    # --------------------------------------------------------
    # ONE MATCH
    # --------------------------------------------------------

    if len(matched_rows) == 1:

        dealer = (
            matched_rows.iloc[0]
        )

        dealer_name_result = (
            str(
                dealer["Dealer_Name"]
            )
        )

        dealer_code_result = (
            str(
                dealer["Dealer_Code"]
            )
        )

        return {
            "success": True,
            "intent": "dealer_code",
            "result": {
                "dealer_name":
                    dealer_name_result,
                "dealer_code":
                    dealer_code_result,
            },
            "response": (
                f"The Dealer Code for "
                f"{dealer_name_result} is "
                f"{dealer_code_result}."
            )
        }

    # --------------------------------------------------------
    # MULTIPLE MATCHES
    # --------------------------------------------------------

    dealers = []

    for _, row in matched_rows.iterrows():

        dealers.append({
            "dealer_name":
                str(row["Dealer_Name"]),
            "dealer_code":
                str(row["Dealer_Code"]),
        })

    return {
        "success": True,
        "intent": "dealer_code",
        "result": {
            "matches": dealers,
        },
        "response": (
            f"I found multiple dealer matches for "
            f"'{dealer_name}'. Please specify the "
            f"exact dealer name."
        )
    }


