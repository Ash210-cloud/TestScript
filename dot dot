        "Outlet_ID",
        "Dealer_Region",
        "Dealer_State",
        "Year",
        "Mth_Number",
        "Month",
        "Customer_Sub_Type",
        "Customer_Group",
        "Sales_Channel_New",
        "Baseplan_Group",
        "Rateplan",
        "Date",
    ]

    missing_columns = [
        column
        for column in required_columns
        if column not in df.columns
    ]

    if missing_columns:

        return jsonify({
            "success": False,
            "error": (
                "Dataset is missing required SPD columns."
            ),
            "missing_columns": missing_columns,
        }), 400

    # --------------------------------------------------------
    # RUN SPD ANALYSIS
    # --------------------------------------------------------

    try:

        analysis = get_spd_complete_analysis(
            df
        )

        # ----------------------------------------------------
        # CONVERT DATAFRAMES TO JSON-SAFE DATA
        # ----------------------------------------------------

        response_data = {}

        for key, value in analysis.items():

            if isinstance(
                value,
                pd.DataFrame
            ):

                clean_value = (
                    value
                    .where(
                        pd.notna(value),
                        None
                    )
                )

                response_data[key] = (
                    clean_value
                    .to_dict(
                        orient="records"
                    )
                )

            elif isinstance(
                value,
                dict
            ):

                clean_value = {}

                for item_key, item_value in value.items():

                    if pd.isna(item_value) if not isinstance(
                        item_value,
                        (list, dict)
                    ) else False:

                        clean_value[item_key] = None

                    else:

                        clean_value[item_key] = item_value

                response_data[key] = clean_value

            else:

                response_data[key] = value

        # ----------------------------------------------------
        # RETURN SPD ANALYSIS
        # ----------------------------------------------------

        return jsonify({
            "success": True,
            "dataset_type": "SPD_Data",
            "rows": len(df),
            "analysis": response_data,
        })

    except Exception as error:

        print("\n" + "=" * 60)
        print("SPD DASHBOARD ANALYSIS API ERROR")
        print("=" * 60)

        traceback.print_exc()

        print("=" * 60 + "\n")

