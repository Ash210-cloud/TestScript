@app.route("/api/upload", methods=["POST"])
def upload_dataset():

    global df

    # --------------------------------------------------------
    # CHECK FILE
    # --------------------------------------------------------

    if "file" not in request.files:

        return jsonify({
            "success": False,
            "error": "No file was uploaded."
        }), 400

    uploaded_file = request.files["file"]

    # --------------------------------------------------------
    # CHECK FILENAME
    # --------------------------------------------------------

    if not uploaded_file.filename:

        return jsonify({
            "success": False,
            "error": "No file was selected."
        }), 400

    # --------------------------------------------------------
    # CHECK EXCEL EXTENSION
    # --------------------------------------------------------

    filename = uploaded_file.filename.lower()

    if not (
        filename.endswith(".xlsx")
        or filename.endswith(".xls")
    ):

        return jsonify({
            "success": False,
            "error": (
                "Invalid file type. "
                "Please upload an Excel file."
            )
        }), 400

    # --------------------------------------------------------
    # READ EXCEL
    # --------------------------------------------------------

    try:

        new_df = pd.read_excel(
            uploaded_file
        )

        # Normalize column names
        new_df.columns = (
            new_df.columns
            .astype(str)
            .str.strip()
        )

        if (
            "Total" not in new_df.columns
            and "Total_NGBB" in new_df.columns
        ):
            new_df = new_df.rename(
                columns={
                    "Total_NGBB": "Total"
                }
            )

        print("\nUPLOADED EXCEL COLUMNS:")
        print(new_df.columns.tolist())

    except Exception as error:

        return jsonify({
            "success": False,
            "error": (
                "Failed to read Excel file: "
                f"{str(error)}"
            )
        }), 400

    # --------------------------------------------------------
    # CHECK DATA
    # --------------------------------------------------------

    if new_df.empty:

        return jsonify({
            "success": False,
            "error": "The uploaded Excel file contains no data."
        }), 400

    # --------------------------------------------------------
    # DETECT DATASET TYPE
    # --------------------------------------------------------

    if "Device_Name" in new_df.columns:

        dataset_type = "SPD_Data_Device"

    else:

        dataset_type = "SPD_Data"

    print(
        f"\nDetected dataset type: {dataset_type}"
    )

    # --------------------------------------------------------
    # REQUIRED COLUMNS
    # --------------------------------------------------------

    required_columns = [
        "Total",
        "Dealer_Code",
        "Dealer_Name",
        "Outlet_ID",
        "Dealer_Region",
        "Dealer_State",
        "Year",
        "Mth_Number",
        "Month",
        "Sales_Channel_New",
        "Rateplan",
        "Baseplan_Group",
        "Customer_Sub_Type",
    ]

    # --------------------------------------------------------
    # DEVICE DATASET REQUIRED COLUMNS
    # --------------------------------------------------------

    if dataset_type == "SPD_Data_Device":

        required_columns.extend([
            "Device_Name",
            "Recontract_Flag",
            "Contract_Type",
        ])

    missing_columns = [
        column
        for column in required_columns
        if column not in new_df.columns
    ]

    if missing_columns:

        return jsonify({
            "success": False,
            "error": "Uploaded Excel is missing required columns.",
            "missing_columns": missing_columns,
        }), 400

    # --------------------------------------------------------
    # REPLACE CURRENT DATASET
    # --------------------------------------------------------

    df = new_df

    print("\n" + "=" * 60)
    print("NEW DATASET UPLOADED")
    print("=" * 60)

    print(
        f"File: {uploaded_file.filename}"
    )

    print(
        f"Dataset Type: {dataset_type}"
    )

    print(
        f"Rows: {len(df):,}"
    )

    print(
        f"Columns: {len(df.columns):,}"
    )

    print("\nACTIVE DATASET COLUMNS:")
    print(df.columns.tolist())

    print("=" * 60)

    # --------------------------------------------------------
    # RETURN SUCCESS
    # --------------------------------------------------------

    return jsonify({
        "success": True,
        "filename": uploaded_file.filename,
        "dataset_type": dataset_type,
        "rows": len(df),
        "columns": len(df.columns),
        "message": "Dataset uploaded successfully.",
    })


