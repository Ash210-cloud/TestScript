@app.route("/api/dashboard/sales-trend", methods=["GET"])
def sales_trend():

    # --------------------------------------------------------
    # CHECK DATASET
    # --------------------------------------------------------

    if df.empty:

        return jsonify({
            "success": False,
            "error": "Dataset is not loaded."
        }), 500

    # --------------------------------------------------------
    # REQUIRED COLUMNS
    # --------------------------------------------------------

    required_columns = [
        "Total",
        "Year",
        "Mth_Number",
        "Month",
    ]

    missing_columns = [
        column
        for column in required_columns
        if column not in df.columns
    ]

    if missing_columns:

        return jsonify({
            "success": False,
            "error": (
                "Dataset is missing required columns "
                "for Sales Trend."
            ),
            "missing_columns": missing_columns,
        }), 400

    # --------------------------------------------------------
    # PROCESS SALES DATA
    # --------------------------------------------------------

    try:

        sales_df = df[
            [
                "Total",
                "Year",
                "Mth_Number",
                "Month",
            ]
        ].copy()

        # ----------------------------------------------------
        # NORMALIZE TOTAL
        # ----------------------------------------------------

        sales_df["Total"] = (
            pd.to_numeric(
                sales_df["Total"],
                errors="coerce"
            )
            .fillna(0)
        )

        # ----------------------------------------------------
        # NORMALIZE YEAR
        # ----------------------------------------------------

        sales_df["Year"] = (
            pd.to_numeric(
                sales_df["Year"],
                errors="coerce"
            )
        )

        # ----------------------------------------------------
        # NORMALIZE MONTH NUMBER
        # ----------------------------------------------------

        sales_df["Mth_Number"] = (
            pd.to_numeric(
                sales_df["Mth_Number"],
                errors="coerce"
            )
        )

        # ----------------------------------------------------
        # REMOVE INVALID DATE ROWS
        # ----------------------------------------------------

        sales_df = sales_df.dropna(
            subset=[
                "Year",
                "Mth_Number"
            ]
        )

        # ----------------------------------------------------
        # GROUP SALES BY YEAR + MONTH
        # ----------------------------------------------------

        monthly_sales = (
            sales_df
            .groupby(
                [
                    "Year",
                    "Mth_Number",
                    "Month",
                ],
                as_index=False
            )["Total"]
            .sum()
        )

        # ----------------------------------------------------
        # SORT CHRONOLOGICALLY
        # ----------------------------------------------------

        monthly_sales = (
            monthly_sales
            .sort_values(
                [
                    "Year",
                    "Mth_Number",
                ]
            )
            .reset_index(drop=True)
        )

        # ----------------------------------------------------
        # CREATE DISPLAY LABEL
        # ----------------------------------------------------

        monthly_sales["Label"] = (
            monthly_sales["Month"]
            .astype(str)
            .str.strip()
            + " "
            + monthly_sales["Year"]
            .astype(int)
            .astype(str)
        )

        # ----------------------------------------------------
        # PREPARE RESPONSE
        # ----------------------------------------------------

        labels = (
            monthly_sales["Label"]
            .tolist()
        )

        values = (
            monthly_sales["Total"]
            .round(2)
            .tolist()
        )

        # ----------------------------------------------------
        # DETAILED DATA
        # ----------------------------------------------------

        data = []

        for _, row in monthly_sales.iterrows():

            data.append({
                "year": int(
                    row["Year"]
                ),
                "month_number": int(
                    row["Mth_Number"]
                ),
                "month": str(
                    row["Month"]
                ),
                "label": str(
                    row["Label"]
                ),
                "total": round(
                    float(row["Total"]),
                    2
                ),
            })

        # ----------------------------------------------------
        # RETURN SALES TREND
        # ----------------------------------------------------

        return jsonify({
            "success": True,
            "labels": labels,
            "values": values,
            "data": data,
        })

    except Exception as error:

        print("\n" + "=" * 60)
        print("SALES TREND API ERROR")
        print("=" * 60)

        traceback.print_exc()

        print("=" * 60 + "\n")

        return jsonify({
            "success": False,
            "error": str(error),
        }), 500


